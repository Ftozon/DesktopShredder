<Window x:Class="DesktopShredder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面碎纸机"
        Width="108"
        Height="124"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        Icon="pack://application:,,,/Assets/shredder.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.ContextMenu>
        <ContextMenu Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569">
            <MenuItem Header="设置 (Settings)..." Click="OpenSettings_Click" />
            <MenuItem Header="重置位置到右下角" Click="ResetPosition_Click" />
            <Separator Background="#334155" />
            <MenuItem Header="退出碎纸机" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootContainer" Margin="6" Cursor="SizeAll" ToolTip="拖入文件或文件夹即可静默彻底粉碎（右键打开设置）">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.42" Color="#000000" />
        </Grid.Effect>

        <Canvas Width="96" Height="112">
            <!-- 1. Document Sheet Feeding Into Top Slot (animates downward during shredding) -->
            <Canvas x:Name="PaperSheetCanvas" Canvas.Left="24" Canvas.Top="4" Width="48" Height="36" ClipToBounds="True">
                <Border x:Name="PaperSheet" Width="48" Height="36" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3,3,0,0">
                    <StackPanel Margin="7,7,7,0">
                        <Border Height="3" Width="24" HorizontalAlignment="Left" Background="#EF4444" CornerRadius="1.5" Margin="0,0,0,4" />
                        <Border Height="2.5" Background="#94A3B8" CornerRadius="1.2" Margin="0,0,0,4" />
                        <Border Height="2.5" Width="28" HorizontalAlignment="Left" Background="#94A3B8" CornerRadius="1.2" />
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- 2. Lower Shredder Bin Body -->
            <Border Canvas.Left="12" Canvas.Top="46" Width="72" Height="60"
                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1.2"
                    CornerRadius="9">
                <!-- Recessed Viewing Window -->
                <Border Margin="9,12,9,9" Background="#0F172A" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                    <Canvas x:Name="StripsViewport" Width="50" Height="36">
                        <Rectangle x:Name="Strip1" Canvas.Left="5"  Canvas.Top="2" Width="4.5" Height="22" RadiusX="1" RadiusY="1" Fill="#E2E8F0" />
                        <Rectangle x:Name="Strip2" Canvas.Left="12" Canvas.Top="2" Width="4.5" Height="29" RadiusX="1" RadiusY="1" Fill="#F8FAFC" />
                        <Rectangle x:Name="Strip3" Canvas.Left="19" Canvas.Top="2" Width="4.5" Height="18" RadiusX="1" RadiusY="1" Fill="#CBD5E1" />
                        <Rectangle x:Name="Strip4" Canvas.Left="26" Canvas.Top="2" Width="4.5" Height="31" RadiusX="1" RadiusY="1" Fill="#FECACA" />
                        <Rectangle x:Name="Strip5" Canvas.Left="33" Canvas.Top="2" Width="4.5" Height="24" RadiusX="1" RadiusY="1" Fill="#F1F5F9" />
                        <Rectangle x:Name="Strip6" Canvas.Left="40" Canvas.Top="2" Width="4.5" Height="27" RadiusX="1" RadiusY="1" Fill="#E2E8F0" />
                    </Canvas>
                </Border>
            </Border>

            <!-- 3. Shredder Cutter Head / Metallic Housing -->
            <Border x:Name="CutterHead" Canvas.Left="8" Canvas.Top="30" Width="80" Height="23"
                    Background="#475569" BorderBrush="#64748B" BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <!-- Top metallic highlight -->
                    <Border VerticalAlignment="Top" Height="10" Background="#64748B" CornerRadius="6,6,2,2" Opacity="0.75" />

                    <!-- Feed Slot Throat -->
                    <Border x:Name="SlotThroat" VerticalAlignment="Top" Margin="9,4,9,0" Height="6"
                            Background="#0F172A" CornerRadius="2.5" />

                    <!-- Bottom Crimson Safety Accent + Status LED -->
                    <Grid VerticalAlignment="Bottom" Margin="10,0,10,4">
                        <Border x:Name="AccentStripe" HorizontalAlignment="Left" Width="44" Height="2.5"
                                Background="#EF4444" CornerRadius="1.2" />
                        <Ellipse x:Name="StatusLed" HorizontalAlignment="Right" Width="6.5" Height="6.5"
                                 Fill="#22C55E" />
                    </Grid>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
